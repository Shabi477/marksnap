{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://marksnap-production.up.railway.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://marksnap-production.up.railway.app/uploads/:path*" }
  ]
}
