# MarkSnap Backend Environment Variables
# Copy this to .env and fill in the values

# Database — Neon PostgreSQL connection string
# Get this from your Neon dashboard after creating a database
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/marksnap?sslmode=require

# JWT Secret — change this to a random secure string in production
SECRET_KEY=change-me-to-a-random-secret-string

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
